# ITEC 305 / GIT: These generated folders should not be committed.
# node_modules is downloaded by npm install from package.json.
# dist is generated by npm run build. The original source is in src/.
# A "U" beside a new file in Git means UNTRACKED; Git hasn't added it yet.
# git commit saves a local snapshot; git push uploads commits to GitHub.
# Avoid putting passwords, API keys, or private ticket codes in a repo.
node_modules
dist
.DS_Store
